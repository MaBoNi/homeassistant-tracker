# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=gps_tracker
DATABASE_URL=postgresql://postgres:your_password@homeassistant-tracker-db:5432/gps_tracker

# Home Assistant Configuration
HA_API_URL=https://your-home-assistant-url/api
HA_TOKEN=your_long_lived_access_token
HA_USERS=user1,user2,user3

# Application Configuration
DROP_DB_ON_START=False
TRACKER_APP_TOKEN=your_very_secret_static_token

# Initial admin account, created on first start only if no users exist (min 12 chars)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-to-something-long

# Session cookie signing key for /auth/* (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-64-char-hex-string
# Set to False only when serving over plain HTTP (local dev)
SESSION_COOKIE_SECURE=True
SESSION_LIFETIME_HOURS=12

# Frontend Configuration
BACKEND_API_URL=http://homeassistant-tracker-backend:5171

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5172,http://127.0.0.1:5172
# For production, add your domain: https://yourdomain.com

# Observability profile (only used with `docker compose --profile observability up`)
GRAFANA_ADMIN_PASSWORD=changeme-please
