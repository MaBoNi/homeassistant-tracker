# Ignore Python bytecode
__pycache__/
*.pyc
*.pyo

# Ignore virtual environments
venv/
.env/

# Ignore any local environment files
*.env
*.env.*
!.env.template

# Ignore Docker-specific files
docker-compose.override.yml
*.log

# Ignore PostgreSQL data directory
volumes/
postgres_data/

# Ignore IDE/editor-specific files
.vscode/
.idea/
*.swp
*.swo

# Ignore system files
.DS_Store
Thumbs.db

# Ignore logs and temp files
*.log
*.tmp

# Ignore build artifacts
build/
dist/
*.egg-info

# Ignore local development files
*local.yml
*backup.*

# Ignore AI generated files as they can contain sensitive information
*.chat
*.gpt
*.ai
*.prompt
*.response
CLAUDE.md
WARP.md
copilot-instructions.md
cursorrules.md

# Ignore Infisical secret files
.infisical.json

# Ignore Safety CLI data
.safety/
.safety-db/
.safety-report.json
.safety-ignore
.safety-cache
.safety-temp
.safety-vcs-ignore
.safety-project.ini
